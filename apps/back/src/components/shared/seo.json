{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "Seo",
    "icon": "search",
    "description": "Champs de référencement (SEO) entièrement personnalisables"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "required": true,
      "maxLength": 70
    },
    "metaDescription": {
      "type": "text",
      "required": true,
      "maxLength": 160,
      "minLength": 50
    },
    "metaImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "keywords": {
      "type": "text"
    },
    "metaRobots": {
      "type": "string",
      "regex": "^(index|noindex)?(,\\s?(follow|nofollow))?$"
    },
    "canonicalURL": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "structuredData": {
      "type": "json"
    }
  }
}
