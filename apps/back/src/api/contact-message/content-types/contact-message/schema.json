{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "singularName": "contact-message",
    "pluralName": "contact-messages",
    "displayName": "Demande de contact",
    "description": "Messages envoyés depuis le formulaire de contact du site"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "reason": {
      "type": "enumeration",
      "enum": ["mariage", "prive", "professionnel", "autre"],
      "default": "mariage",
      "required": true
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "eventDate": {
      "type": "date"
    },
    "location": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    }
  }
}
