# ============================================================
#  Fichier d'exemple — COPIER en `.env` sur le VPS puis remplir.
#  cp .env.prod.example .env
#  NE JAMAIS committer le vrai fichier .env (déjà ignoré par git).
# ============================================================

# ---- Domaines ----------------------------------------------
DOMAIN=justincom.fr
API_DOMAIN=api.justincom.fr

# ---- Frontend (Next.js) — gelées AU BUILD ------------------
NEXT_PUBLIC_SITE_URL=https://justincom.fr
NEXT_PUBLIC_STRAPI_URL=https://api.justincom.fr

# ---- Backend (Strapi) --------------------------------------
PUBLIC_URL=https://api.justincom.fr
CORS_ORIGINS=https://justincom.fr,https://www.justincom.fr

# Secrets Strapi — génère CHAQUE valeur avec :  openssl rand -base64 32
# APP_KEYS = 4 clés séparées par des virgules.
APP_KEYS=CHANGE_ME_1,CHANGE_ME_2,CHANGE_ME_3,CHANGE_ME_4
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
